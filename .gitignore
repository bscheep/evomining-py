# Python build / cache
__pycache__/
*.pyc
*.egg-info/
# anchored: an unanchored `build/` also matches nested source directories
/build/
/dist/
*.editable-*.whl

# Example genomes: 233 MB of GenBank downloaded from NCBI, too large to commit.
# tests/data/accessions.txt lists what to fetch; tests needing them skip when absent.
# Everything else under tests/data/ IS committed (the enzyme DB and the BLAST fixture),
# so keep this rule pointed at the genome directory rather than at tests/data/. bob_bakta_los17 were
# the original that Bob used
tests/data/los17_genomes/
tests/data/bob_bakta_los17
# Full MIBiG protein set (~31 MB). Only `analyze --mibig` needs it; the tree tests use
# the 30-sequence subset in tests/data/mibig/, which is verified to give the same result.
### For continuity, the Mibig db will be part of the commit, it's below the github limit

# dev scratch — never publish these
baks/
used_patches/
*.bak
*.bak[0-9]*

# env / editor
.env
.vscode/
.idea/
